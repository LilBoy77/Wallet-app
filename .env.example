# ==========================================
# WALLET APP ENVIRONMENT CONFIGURATION
# (Salin file ini menjadi .env sebelum memulai aplikasi)
# ==========================================

# Server Environment
NODE_ENV=development
API_PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Request Pipeline & Security
BODY_SIZE_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
PAGINATION_MAX_LIMIT=100

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_local_only
DB_NAME=wallet_app_db
DATABASE_URL=postgresql://postgres:change_me_local_only@localhost:5432/wallet_app_db
TEST_DATABASE_URL=postgresql://postgres:change_me_local_only@localhost:5432/wallet_test

# Authentication & JWT Security (Phase 4)
# Minimal 32 karakter unik. DILARANG menggunakan placeholder pada production!
JWT_ACCESS_SECRET=your_32_characters_random_secret_for_access_token_min_len
JWT_REFRESH_SECRET=your_32_characters_random_secret_for_refresh_token_min_len
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=wallet-app-api
JWT_AUDIENCE=wallet-app-client

# Application URLs & Password Reset
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=15

# Password Hashing (Argon2id Parameters)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Mail Service (Local Outbox vs SMTP)
# 'outbox' menulis berkas email ke direktori apps/api/.outbox/ (hanya untuk dev/test)
MAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Financial & Simulation Policy (Phase 5)
# Gating simulasi pengisian saldo: WAJIB false pada production!
ENABLE_TOPUP_SIMULATION=false
TOPUP_MAX_AMOUNT_PER_TX=50000000
INCOME_MAX_AMOUNT_PER_TX=50000000
TRANSFER_MAX_AMOUNT_PER_TX=50000000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
