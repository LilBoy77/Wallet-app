# ==========================================
# WALLET APP ENVIRONMENT CONFIGURATION
# (Salin file ini menjadi .env sebelum memulai aplikasi)
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=wallet_app_db
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/wallet_app_db

# Security & JWT Secrets (Ganti dengan string random aman min. 32 karakter)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads/attachments
MAX_FILE_SIZE_BYTES=2097152

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
