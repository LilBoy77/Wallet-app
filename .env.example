# ==========================================
# WALLET APP ENVIRONMENT CONFIGURATION
# (Salin file ini menjadi .env sebelum memulai aplikasi)
# ==========================================

# Server Environment
NODE_ENV=development
API_PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Request Pipeline & Security
BODY_SIZE_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
PAGINATION_MAX_LIMIT=100

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_local_only
DB_NAME=wallet_app_db
DATABASE_URL=postgresql://postgres:change_me_local_only@localhost:5432/wallet_app_db
TEST_DATABASE_URL=postgresql://postgres:change_me_local_only@localhost:5432/wallet_test

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
