{
  "name": "wallet-app-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack personal finance and internal wallet management application",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@wallet-app/*\" dev",
    "build": "pnpm --recursive --filter \"@wallet-app/*\" build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {}
}
