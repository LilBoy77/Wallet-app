{
  "name": "@wallet-app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/database/scripts/migrate.ts",
    "db:rollback": "tsx src/database/scripts/rollback.ts",
    "db:status": "tsx src/database/scripts/status.ts",
    "db:seed": "tsx src/database/scripts/seed.ts",
    "db:reset": "tsx src/database/scripts/reset.ts",
    "db:verify": "tsx src/database/scripts/verify.ts",
    "migrate:latest": "tsx src/database/scripts/migrate.ts",
    "migrate:rollback": "tsx src/database/scripts/rollback.ts",
    "seed:run": "tsx src/database/scripts/seed.ts"
  },
  "dependencies": {
    "@wallet-app/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
